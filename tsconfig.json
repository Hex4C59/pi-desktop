{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false,
    "baseUrl": ".",
    "types": ["vite/client"]
  },
  "include": [
    "forge.config.ts",
    "forge.env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.*.config.ts",
    "vite.*.config.mts"
  ],
  "exclude": ["node_modules", ".vite", "out"]
}
